  "findings": [
    {
      "level": "RISK",
      "code": "TOKENIZATION_DISTRIBUTION_SHIFT",
      "detail": "ATE inference uses regex word/punctuation splitting of raw text; training used source Tokens. ATSC training used space-joined source Tokens, but runtime can receive raw punctuation/whitespace. The exact same original review must be passed to both modules, without normalizing/rebuilding it."
    },
    {
      "level": "RISK",
      "code": "TOKEN_BUDGET_MISMATCH",
      "detail": "ATE accepts up to 128 model tokens; ATSC uses a 128-token review+target pair including 2 extra markers. An ATE-accepted review can still exceed the ATSC budget; do not truncate or silently drop an aspect."
    },
    {
      "level": "RISK",
      "code": "MODEL_DOMAIN_LIMITATION",
      "detail": "Separate gold-aspect ATSC test metrics cannot be used as end-to-end ATE->ATSC performance; no pipeline performance was measured in this audit."
    },
    {
      "level": "INFO",
      "code": "PYTHON_OFFSETS",
      "detail": "Both Python modules use Unicode code point indexes, not UTF-8 byte offsets or JavaScript UTF-16 indices."
    },
    {
      "level": "INFO",
      "code": "MODEL_INSTANCES",
      "detail": "ATE and ATSC require different task heads; load each model once and keep raw review unchanged."
    },
    {
      "level": "RISK",
      "code": "TOKEN_BUDGET_DIVERGENCE_REPRODUCED",
      "detail": "See tokenizers.budget_divergence_cases: ATE fits but ATSC would refuse."
    }
  ],
